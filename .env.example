# ===== App Settings =====
APP_NAME=Video Processing Service
APP_VERSION=1.0.0
DEBUG=true

# ===== Security =====
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Database =====
DATABASE_URL=sqlite:///./data/app.db

# ===== Storage =====
# Video output files are stored locally at ./data/output/
# and served via the API download endpoint: /api/v1/video/download/{filename}

# ===== Cloudflare Tunnel (optional) =====
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ===== Upload Settings =====
MAX_UPLOAD_SIZE_MB=500
TEMP_DIR=/tmp/video-processing
